# GEMINI_API_KEY: Injected automatically by AI Studio for Gemini / Gemma models.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# AI Model Provider: 'gemini' (default, uses Gemini/Gemma models via Google GenAI SDK),
# 'openrouter' (for open-weight models like Gemma 2, Llama 3.1, Qwen 2.5),
# or 'huggingface' (Hugging Face Serverless Inference API)
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.8-flash"

# Optional Alternative Hosted Inference API Keys:
OPENROUTER_API_KEY=""
HUGGINGFACE_API_KEY=""

# SQLite Persistent Database File Path
DATABASE_FILE="./data/civiclens.sqlite"

# Admin Demonstration Access Passcode (Not for production auth)
ADMIN_DEMO_PIN="1234"
